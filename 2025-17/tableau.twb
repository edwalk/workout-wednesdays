      <aliases enabled='yes' />
      <column caption='Selected Cumu Stat Field' datatype='integer' name='[Calculation_531846973481357312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Goal Difference&apos;&#10;THEN [Cumulative Goal Difference]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Goals Against&apos;&#10;THEN [Cumulative Goals Against]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Goals For&apos;&#10;THEN [Cumulative Goals For]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Points&apos;&#10;THEN [Cumulative Points]&#10;END' />
      </column>
      <column caption='Goals Against Negative' datatype='integer' name='[Calculation_531846973481865217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[Goals Against]' />
      </column>
      <column caption='Cumulative Goals Against Negative' datatype='integer' name='[Calculation_531846973482721282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[Cumulative Goals Against]' />
      </column>
      <column caption='Ranking Field' datatype='integer' name='[Calculation_793055752586342400]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Goals Against&apos;&#10;THEN -1 * RANK_UNIQUE(SUM([Calculation_531846973481357312]))&#10;ELSE RANK_UNIQUE(SUM([Calculation_531846973481357312]))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Team TF' datatype='boolean' name='[Calculation_793055752589197313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 2] = [Team] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Selected Team T/F Color' datatype='string' name='[Calculation_793055752590016514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_793055752589197313] = FALSE THEN &apos;Light Purple&apos; ELSE &apos;Dark Purple&apos; END' />
      </column>
      <column caption='Max Label' datatype='integer' name='[Calculation_793055752590450691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Goals Against&apos;&#10;THEN {FIXED [Season End Year]: MIN([Calculation_531846973481357312]) }&#10;ELSE {FIXED [Season End Year]: MAX([Calculation_531846973481357312]) }&#10;END' />
      </column>
      <column caption='Selected team Label' datatype='integer' name='[Calculation_793055752591532036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_793055752589197313] THEN [Calculation_531846973481357312] END' />
      </column>
      <column caption='Combined label' datatype='string' name='[Calculation_793055752591683589]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Calculation_793055752591532036])&#10;THEN STR([Calculation_793055752591532036])&#10;ELSEIF [Calculation_531846973481357312] = [Calculation_793055752590450691]&#10;THEN STR([Calculation_793055752590450691])&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='Max Test' datatype='boolean' name='[Calculation_793055752601313288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_793055752590450691] = [Calculation_531846973481357312]' />
      </column>
      <column caption='Combined Label String' datatype='string' name='[Calculation_818529237995065345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_793055752591683589])' />
      </column>
      <column caption='Min Label' datatype='integer' name='[Calculation_818529238006411269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Season End Year] : MIN([Selected Stat Field (copy)_818529237997264898]) }' />
      </column>
      <column caption='Min to Max label' datatype='integer' name='[Max Label (copy)_818529237999738884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Goals Against&apos;&#10;THEN {FIXED [Season End Year]: MAX([Calculation_531846973481357312]) } - {FIXED [Season End Year]: MIN([Calculation_531846973481357312]) }&#10;ELSE {FIXED [Season End Year]: MIN([Calculation_531846973481357312]) } - {FIXED [Season End Year]: MAX([Calculation_531846973481357312]) }&#10;END' />
      </column>
      <column caption='Selected Stat Field' datatype='integer' name='[Selected Stat Field (copy)_818529237997264898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Goal Difference&apos;&#10;THEN [Goal Difference]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Goals Against&apos;&#10;THEN [Goals Against]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Goals For&apos;&#10;THEN [Goals For]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Points&apos;&#10;THEN [Points]&#10;END' />
      </column>
